# ===== ARICECLEAN - HTACCESS CONFIGURATION =====
# Otimizações para Apache Server (Softaculous/InfocoHost)

# ===== REWRITE ENGINE =====
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Remove www
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ http://%1/$1 [R=301,L]
  
  # Force HTTPS (descomente se seu certificado SSL estiver ativo)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Remove trailing slash
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]
</IfModule>

# ===== SECURITY HEADERS =====
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Prevent clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Enable XSS protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Content Security Policy (ajuste conforme necessário)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://formspree.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://formspree.io;"
</IfModule>

# ===== COMPRESSION =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# ===== CACHING =====
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS
  ExpiresByType text/css "access plus 1 month"
  
  # JavaScript
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  
  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  
  # HTML (não cache)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ===== BROWSER CACHE =====
<IfModule mod_headers.c>
  # Cache Control
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|otf)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # HTML não cache
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ===== DISABLE DIRECTORY LISTING =====
Options -Indexes

# ===== BLOCK HOTLINKING =====
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?ariceclean\.com\.br [NC]
  RewriteRule \.(jpg|jpeg|png|gif|css|js)$ - [F,NC]
</IfModule>

# ===== BLOCK ACCESS TO SENSITIVE FILES =====
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|composer\.json|composer\.lock|\.git|\.gitignore)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ===== DISABLE XML-RPC (se não usar) =====
<Files "xmlrpc.php">
  Order allow,deny
  Deny from all
</Files>

# ===== 404 ERROR PAGE =====
# ErrorDocument 404 /404.html

# ===== 403 ERROR PAGE =====
# ErrorDocument 403 /403.html

# ===== 500 ERROR PAGE =====
# ErrorDocument 500 /500.html

# ===== GZIP COMPRESSION (alternativo) =====
<IfModule mod_gzip.c>
  mod_gzip_on Yes
  mod_gzip_dechunk Yes
  mod_gzip_item_include file \.(html?|txt|css|js|php|svg)$
  mod_gzip_item_include handler ^cgi-script$
  mod_gzip_item_exclude mime ^image/
  mod_gzip_item_exclude rn \.(zip|exe)$
  mod_gzip_item_include mime ^application/x-javascript$
  mod_gzip_item_include mime ^text/javascript$
  mod_gzip_level 6
  mod_gzip_min_http 1000
  mod_gzip_vary On
</IfModule>

# ===== PROTECT FROM SQL INJECTION =====
<IfModule mod_rewrite.c>
  RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} UNION.*SELECT [NC,OR]
  RewriteCond %{QUERY_STRING} union.*select [NC]
  RewriteRule ^(.*)$ index.html [F,L]
</IfModule>

# ===== BLOCK COMMON ATTACKS =====
<IfModule mod_rewrite.c>
  # Block access to wp-admin if WordPress is not used
  RewriteRule ^wp-admin - [F,L]
  RewriteRule ^wp-login\.php - [F,L]
</IfModule>

# ===== FILE UPLOAD RESTRICTIONS =====
<IfModule mod_authz_core.c>
  <FilesMatch "\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

# ===== ALLOW SPECIFIC FILE TYPES =====
AddType text/html .html
AddType text/css .css
AddType application/javascript .js
AddType image/jpeg .jpg .jpeg
AddType image/png .png
AddType image/gif .gif
AddType image/svg+xml .svg
AddType application/json .json
AddType font/ttf .ttf
AddType font/otf .otf
AddType font/woff .woff
AddType font/woff2 .woff2

# ===== CHARSET UTF-8 =====
AddDefaultCharset UTF-8

# ===== END OF HTACCESS =====
